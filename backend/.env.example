# Copy this file to `.env` in the same folder (backend/.env) and fill in real values.
# Never commit the real `.env` — it's already in .gitignore.

# --- Environment ---
# "development" (default) or "production". In production, the app refuses to
# boot if JWT_SECRET is still the default — see main.py.
ENV=development
LOG_LEVEL=INFO

# --- Database ---
# Local dev default (zero config):
DATABASE_URL=sqlite:///./finguard.db
# Postgres (recommended for deployment + Power BI's native connector):
# DATABASE_URL=postgresql://finguard:yourpassword@localhost:5432/finguard
# MySQL:
# DATABASE_URL=mysql+pymysql://finguard:yourpassword@localhost:3306/finguard

# --- Auth ---
# REQUIRED in production. Generate a strong random secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-in-your-.env-file

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting ---
DEFAULT_RATE_LIMIT=100/minute

# --- Optional: real GPT-powered savings tips ---
# Without this set, /insights/ai-advice automatically falls back to rule-based
# tips, so the app and your demo never break — just less "AI-flavored".
OPENAI_API_KEY=
